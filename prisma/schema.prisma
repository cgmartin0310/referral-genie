// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String                     @id @default(cuid())
  name               String
  slug               String                     @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  clinicLocations    ClinicLocation[]
  referralSources    ReferralSource[]
  referralCategories ReferralCategory[]
  interactions       Interaction[]
  campaigns          Campaign[]
  campaignSources    CampaignToReferralSource[]
  countyIngestRuns   CountyIngestRun[]
  researchRuns       ResearchRun[]
}

model ClinicLocation {
  id              String           @id @default(cuid())
  name            String
  address         String?
  city            String?
  state           String?
  zipCode         String?
  phoneNumber     String?
  faxNumber       String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  referralSources ReferralSource[]
  marketCounties  ClinicMarketCounty[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Counties this clinic serves. Any US county can be saved. The NPI pull
/// still runs only for counties that have a practice-location ZIP list.
model ClinicMarketCounty {
  id               String         @id @default(cuid())
  clinicLocationId String
  clinicLocation   ClinicLocation @relation(fields: [clinicLocationId], references: [id], onDelete: Cascade)
  countyFips       String
  countyName       String
  state            String
  createdAt        DateTime       @default(now())

  @@unique([clinicLocationId, countyFips])
  @@index([clinicLocationId])
}

model ReferralSource {
  id                       String                     @id @default(cuid())
  name                     String
  address                  String?
  city                     String?
  state                    String?
  zipCode                  String?
  clinicLocationId         String?
  clinicLocation           ClinicLocation?            @relation(fields: [clinicLocationId], references: [id])
  contactPerson            String?
  contactTitle             String?
  contactPhone             String?
  contactEmail             String?
  faxNumber                String?
  npiNumber                String?
  website                  String?
  notes                    String?
  rating                   Float?
  expectedMonthlyReferrals Int?
  numberOfProviders        Int?
  referralFormUrl          String?
  preferredChannel         String?
  taxonomyCodes            String[]                   @default([])
  primaryTaxonomyCode      String?
  enumerationType          String?
  countyName               String?
  countyFips               String?
  placeId                  String?
  latitude                 Float?
  longitude                Float?
  reviewCount              Int?
  businessStatus           String?
  sourceType               String?
  provenance               Json?
  placesMatchStatus        String?
  likelyDuplicate          Boolean                    @default(false)
  duplicateClusterKey      String?
  addressFlags             String[]                   @default([])
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  categoryId               String?
  category                 ReferralCategory?          @relation(fields: [categoryId], references: [id])
  organizationId           String
  organization             Organization               @relation(fields: [organizationId], references: [id])
  interactions             Interaction[]
  campaigns                CampaignToReferralSource[]

  @@unique([organizationId, npiNumber])
  @@index([organizationId, countyFips])
  @@index([organizationId])
}

model ReferralCategory {
  id              String           @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  referralSources ReferralSource[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Interaction {
  id               String         @id @default(cuid())
  referralSourceId String
  referralSource   ReferralSource @relation(fields: [referralSourceId], references: [id])
  type             String
  date             DateTime
  notes            String?
  outcome          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Campaign {
  id                    String                     @id @default(cuid())
  name                  String
  description           String?
  startDate             DateTime
  endDate               DateTime?
  status                String                     @default("DRAFT")
  type                  String
  content               String?
  documentUrl           String?
  documentName          String?
  coverSheetFromName    String?
  coverSheetFromNumber  String?
  coverSheetCompanyInfo String?
  coverSheetSubject     String?
  coverSheetMessage     String?
  includeCoverSheet     Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  organizationId        String
  organization          Organization               @relation(fields: [organizationId], references: [id])
  referralSources       CampaignToReferralSource[]

  @@index([organizationId])
}

model CampaignToReferralSource {
  campaignId       String
  referralSourceId String
  status           String         @default("PENDING")
  sentAt           DateTime?
  responseAt       DateTime?
  response         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  campaign         Campaign       @relation(fields: [campaignId], references: [id])
  referralSource   ReferralSource @relation(fields: [referralSourceId], references: [id])

  @@id([campaignId, referralSourceId])
  @@index([organizationId])
}

/// One county seed/refresh. Progress is stored here so a Render request can
/// finish a slice and the next request (or the shell script) can resume.
model CountyIngestRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  countyId       String
  countyName     String
  countyFips     String
  status         String       @default("QUEUED")
  phase          String       @default("nppes")
  cursor         Json
  summary        Json
  error          String?
  lockedAt       DateTime?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, countyId, createdAt])
}

/// One research pass over a clinic market or a single referral source.
/// Each request handles one practice site, then the next request resumes.
model ResearchRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scopeKey       String
  status         String       @default("QUEUED")
  cursor         Json
  summary        Json
  error          String?
  lockedAt       DateTime?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, scopeKey, createdAt])
}
