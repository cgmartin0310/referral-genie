// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String                     @id @default(cuid())
  name               String
  slug               String                     @unique
  /// The Clerk organization this subscriber signs in as.
  clerkOrgId         String?                    @unique
  /// "paragon" runs the program and owns the shared county catalog; everyone else is a "subscriber".
  kind               String                     @default("subscriber")
  /// Onboarding: the practice owner and the day-to-day contact.
  ownerName          String?
  ownerPhone         String?
  ownerEmail         String?
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  /// When the subscriber finished onboarding.
  onboardedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  clinicLocations    ClinicLocation[]
  referralSources    ReferralSource[]
  referralCategories ReferralCategory[]
  interactions       Interaction[]
  campaigns          Campaign[]
  campaignSources    CampaignToReferralSource[]
  campaignTargets    CampaignTarget[]
  countyIngestRuns   CountyIngestRun[]
  researchRuns       ResearchRun[]
  practices          Practice[]
  providers          Provider[]
  clinicPractices    ClinicPractice[]
  discoveredPlaces   DiscoveredPlace[]
  estimateSettings   EstimateSettings?
  faxSettings        FaxSettings?
  faxDocuments       FaxDocument[]
  practiceScores     PracticeScore[]
  catalogSettings    CatalogSettings?
  relationships      SourceRelationship[]
  prospectDecisions  ProspectDecision[]
}

/// A therapy practice Paragon may recruit as a subscriber (CO Universe),
/// built from the NPI file for a county. Separate from the referral catalog.
model CoLead {
  id           String   @id @default(cuid())
  /// Identity within the county: org:<npi>, the address group, or npi:<npi> for a solo therapist.
  key          String
  countyFips   String
  countyName   String?
  name         String
  address      String?
  city         String?
  zipCode      String?
  phone        String?
  faxNumber    String?
  orgNpis      String[] @default([])
  /// Therapists here by discipline: { pt, ot, st }.
  therapists   Json
  pediatric    Boolean  @default(false)
  /// queued, outreach_active, engaged, signup_started, converted, not_interested.
  stage        String   @default("queued")
  notes        String?
  assignee     String?
  /// No longer on the NPI file at the last pull; kept for its history.
  retiredAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([countyFips, key])
  @@index([countyFips])
}

/// One outreach touch on a catalog practice (a call now; fax and AI call
/// later), with its outcome. Paragon's log; counts only reach subscribers.
model OutreachTouch {
  id           String   @id @default(cuid())
  practiceId   String
  channel      String   @default("call")
  outcome      String
  notes        String?
  actor        String?
  createdAt    DateTime @default(now())

  @@index([practiceId, createdAt])
}

/// A subscriber's decision on a catalog practice offered as a prospect.
/// No row means proposed. Every decision is logged with who made it.
model ProspectDecision {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  practiceId     String
  /// approved or excluded.
  status         String
  decidedBy      String?
  decidedAt      DateTime     @default(now())

  @@unique([organizationId, practiceId])
  @@index([organizationId])
}

/// A referral source a subscriber already works with (entered or uploaded),
/// matched to the shared catalog when it can be. Private to the subscriber.
model SourceRelationship {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  clinicLocationId String?
  /// The catalog practice this is, when matched.
  practiceId       String?
  /// How it matched the catalog: npi, fax, phone, or name.
  matchedBy        String?
  name             String
  practiceName     String?
  npi              String?
  specialty        String?
  phone            String?
  fax              String?
  email            String?
  address          String?
  city             String?
  state            String?
  zip              String?
  /// practice, physician, school, or other.
  type             String   @default("practice")
  lastReferral     String?
  referralVolume   String?
  strength         String?
  origin           String?
  /// Trust Relationship Score, 0 to 100. Analytics only.
  trs              Int      @default(0)
  /// upload or manual.
  createdFrom      String   @default("manual")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
  @@index([practiceId])
}

/// Which specialties the shared county catalog pulls (Paragon's choice).
model CatalogSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// Specialty groups from lib/nppes/taxonomies (TAXONOMY_GROUPS).
  enabledGroups  String[]     @default([])
  updatedAt      DateTime     @updatedAt
}

/// Who outbound faxes come from, and the free phone and fax a recipient uses
/// to stop them. Printed on every page of every campaign fax.
model FaxSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  senderName     String?
  optOutPhone    String?
  optOutFax      String?
  /// No opt-out line on faxes: the company states it has prior express
  /// permission from every practice it faxes. Who said so, and when, is kept.
  suppressOptOut    Boolean   @default(false)
  consentAttestedAt DateTime?
  consentAttestedBy String?
  updatedAt      DateTime     @updatedAt
}

/// A campaign's fax document, kept in the database: files written to the
/// server's disk are lost on every deploy.
model FaxDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  contentType    String
  size           Int
  bytes          Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

/// The referral estimate's rate table: disciplines, and referrals per
/// provider per month for each provider type in each discipline.
model EstimateSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  /// { disciplines: [{ key, label }], rates: { [discipline]: { [sourceType]: number } } }
  rates          Json
  updatedAt      DateTime     @updatedAt
}

/// A practice Google lists in a county. The referral source list is built
/// from these; NPI providers nest under them.
model DiscoveredPlace {
  id              String   @id @default(cuid())
  countyFips      String
  placeId         String
  name            String
  formattedAddress String
  address         String?
  city            String?
  state           String?
  zipCode         String?
  phone           String?
  website         String?
  rating          Float?
  reviewCount     Int?
  businessStatus  String?
  latitude        Float?
  longitude       Float?
  types           String[] @default([])
  /// The searches that returned it, as "town/query".
  queries         String[] @default([])
  /// A listing in a clinician's own name; it folds into the clinic at its address.
  personal        Boolean  @default(false)
  /// "search": found by the county search. "provider": found from a provider's NPI phone or address.
  origin          String   @default("search")
  detailsAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, placeId])
  @@index([organizationId, countyFips])
}

model ClinicLocation {
  id              String           @id @default(cuid())
  name            String
  address         String?
  city            String?
  state           String?
  zipCode         String?
  phoneNumber     String?
  faxNumber       String?
  isActive        Boolean          @default(true)
  /// Discipline keys from the subscriber's estimate settings (pt, ot, st, ...). Empty means all.
  disciplines     String[]         @default([])
  /// Sees children.
  pediatric       Boolean          @default(true)
  payersAccepted  String[]         @default([])
  acceptingNewPatients Boolean     @default(true)
  /// From the address, through Google Places, for distance to practices.
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  referralSources ReferralSource[]
  marketCounties  ClinicMarketCounty[]
  clinicPractices ClinicPractice[]
  campaigns       Campaign[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Counties this clinic serves. Any US county can be saved. The NPI pull
/// still runs only for counties that have a practice-location ZIP list.
model ClinicMarketCounty {
  id               String         @id @default(cuid())
  clinicLocationId String
  clinicLocation   ClinicLocation @relation(fields: [clinicLocationId], references: [id], onDelete: Cascade)
  countyFips       String
  countyName       String
  state            String
  createdAt        DateTime       @default(now())

  @@unique([clinicLocationId, countyFips])
  @@index([clinicLocationId])
}

model ReferralSource {
  id                       String                     @id @default(cuid())
  name                     String
  address                  String?
  city                     String?
  state                    String?
  zipCode                  String?
  clinicLocationId         String?
  clinicLocation           ClinicLocation?            @relation(fields: [clinicLocationId], references: [id])
  contactPerson            String?
  contactTitle             String?
  contactPhone             String?
  contactEmail             String?
  faxNumber                String?
  /// NPI's mailing-address fax, kept apart from the location fax: used for the
  /// practice only when no one there lists a location fax.
  mailingFax               String?
  npiNumber                String?
  website                  String?
  notes                    String?
  rating                   Float?
  expectedMonthlyReferrals Int?
  numberOfProviders        Int?
  referralFormUrl          String?
  preferredChannel         String?
  taxonomyCodes            String[]                   @default([])
  primaryTaxonomyCode      String?
  enumerationType          String?
  countyName               String?
  countyFips               String?
  placeId                  String?
  /// Business name from Google Places. Names a practice that has no organization NPI.
  placeName                String?
  latitude                 Float?
  longitude                Float?
  reviewCount              Int?
  businessStatus           String?
  sourceType               String?
  provenance               Json?
  placesMatchStatus        String?
  likelyDuplicate          Boolean                    @default(false)
  duplicateClusterKey      String?
  addressFlags             String[]                   @default([])
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  categoryId               String?
  category                 ReferralCategory?          @relation(fields: [categoryId], references: [id])
  organizationId           String
  organization             Organization               @relation(fields: [organizationId], references: [id])
  interactions             Interaction[]
  campaigns                CampaignToReferralSource[]

  @@unique([organizationId, npiNumber])
  @@index([organizationId, countyFips])
  @@index([organizationId])
}

model ReferralCategory {
  id              String           @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  referralSources ReferralSource[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Interaction {
  id               String         @id @default(cuid())
  referralSourceId String
  referralSource   ReferralSource @relation(fields: [referralSourceId], references: [id])
  type             String
  date             DateTime
  notes            String?
  outcome          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Campaign {
  id                    String                     @id @default(cuid())
  name                  String
  description           String?
  startDate             DateTime
  endDate               DateTime?
  status                String                     @default("DRAFT")
  type                  String
  content               String?
  documentUrl           String?
  documentName          String?
  coverSheetFromName    String?
  coverSheetFromNumber  String?
  coverSheetCompanyInfo String?
  coverSheetSubject     String?
  coverSheetMessage     String?
  includeCoverSheet     Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  organizationId        String
  organization          Organization               @relation(fields: [organizationId], references: [id])
  referralSources       CampaignToReferralSource[]
  /// The clinic whose referral list is this campaign's audience.
  audienceClinicId      String?
  audienceClinic        ClinicLocation?            @relation(fields: [audienceClinicId], references: [id], onDelete: SetNull)
  /// Tiers on that list to fax (trusted, warm, cold; cold takes in not-yet-scored). Empty: everyone but Not a fit.
  audienceTiers         String[]                   @default([])
  /// Chosen practices on that list (a test fax, a handful); when set, only they are faxed and tiers are ignored.
  audiencePracticeIds   String[]                   @default([])
  targets               CampaignTarget[]

  @@index([organizationId])
  @@index([audienceClinicId])
}

model CampaignToReferralSource {
  campaignId       String
  referralSourceId String
  status           String         @default("PENDING")
  sentAt           DateTime?
  responseAt       DateTime?
  response         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  campaign         Campaign       @relation(fields: [campaignId], references: [id])
  referralSource   ReferralSource @relation(fields: [referralSourceId], references: [id])

  @@id([campaignId, referralSourceId])
  @@index([organizationId])
}

/// One county seed/refresh. Progress is stored here so a Render request can
/// finish a slice and the next request (or the shell script) can resume.
model CountyIngestRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  countyId       String
  countyName     String
  countyFips     String
  status         String       @default("QUEUED")
  phase          String       @default("nppes")
  cursor         Json
  summary        Json
  error          String?
  lockedAt       DateTime?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, countyId, createdAt])
}

/// One research pass over a clinic market or a single referral source.
/// Each request handles one practice site, then the next request resumes.
model ResearchRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  scopeKey       String
  status         String       @default("QUEUED")
  cursor         Json
  summary        Json
  error          String?
  lockedAt       DateTime?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, scopeKey, createdAt])
}


/// A referral source: one practice location.
///
/// Identity is the location, not the organization. NPPES does not link an
/// individual to an employer org NPI, most locations in a county pull have no
/// NPI-2 at all, one org NPI can span several addresses, and one address can
/// host several org NPIs. Org NPIs are recorded on `orgNpis`.
model Practice {
  id             String   @id @default(cuid())
  /// Cluster identity: a Places id when matched, else normalized street+suite+ZIP.
  practiceKey    String
  placeId        String?
  /// Business name on the Google Places listing, when matched.
  placeName      String?
  /// From the Google listing, for distance to a subscriber's clinics.
  latitude       Float?
  longitude      Float?
  name           String
  /// Several org NPIs sit here and the name had to be chosen.
  nameAmbiguous  Boolean  @default(false)
  address        String?
  city           String?
  state          String?
  zipCode        String?
  countyName     String?
  countyFips     String?
  phone          String?
  /// Default fax target for every provider here.
  faxNumber      String?
  /// From Google Places, carried up from the sources here.
  website        String?
  rating         Float?
  reviewCount    Int?
  /// Org (NPI-2) numbers registered at this location. Often empty.
  orgNpis        String[] @default([])
  /// NPI-1 members. Zero means unknown, not an estimate of zero.
  providerCount  Int      @default(0)
  /// Source type to count, for the referral estimate's drivers.
  taxonomyMix    Json?
  /// Set when a pull no longer forms this row but a clinic list or campaign still
  /// points at it. Hidden from Referral Sources; kept for the lists that use it.
  retiredAt      DateTime?
  /// What named the row: "organization" (NPI-2), "listing" (Google), or "provider".
  formedBy       String?
  /// Fields a person changed. The pull leaves them as the person set them.
  editedFields   String[] @default([])
  /// Deleted by a person. The pull keeps it deleted; Restore brings it back.
  hiddenAt       DateTime?
  /// Asked to stop receiving faxes (the opt-out line on every page). Global:
  /// no subscriber's campaign faxes it until Paragon removes the opt-out.
  faxOptOutAt    DateTime?
  /// Who recorded the opt-out (organization name), for Paragon's review.
  faxOptOutBy    String?
  /// Paragon's outreach ladder: queued, outreach_active, rc_identified, engaged, graduated.
  outreachStage  String   @default("queued")
  stageChangedAt DateTime?
  /// The practice's referral coordinator, once identified.
  rcName         String?
  rcPhone        String?
  rcEmail        String?
  /// Who at Paragon owns this practice's outreach.
  assignee       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  providers      Provider[]
  clinicPractices ClinicPractice[]
  scores          PracticeScore[]
  campaignTargets CampaignTarget[]

  @@unique([organizationId, practiceKey])
  @@index([organizationId, countyFips])
}

/// An individual (NPI-1) practising at a Practice. Drives the provider count
/// the referral estimate is built on.
model Provider {
  id                  String   @id @default(cuid())
  npiNumber           String
  name                String
  primaryTaxonomyCode String?
  taxonomyCodes       String[] @default([])
  sourceType          String?
  countyFips          String?
  /// The provider's own fax, when NPPES lists one.
  faxNumber           String?
  /// Send to `faxNumber` instead of the practice fax.
  useOwnFax           Boolean  @default(false)
  /// Removed from the list by a person. The pull leaves them out until restored.
  hiddenAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  practiceId          String?
  practice            Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, npiNumber])
  @@index([practiceId])
  @@index([organizationId, countyFips])
}

/// A practice on a clinic's referral list. This is the association a user
/// makes after sources are pulled and enriched: "these practices refer to
/// this clinic." Relationship data lives here, not on the shared practice.
model ClinicPractice {
  id                       String   @id @default(cuid())
  clinicLocationId         String
  practiceId               String
  /// Optional override of the estimate for this relationship.
  expectedMonthlyReferrals Int?
  notes                    String?
  /// Taken off this clinic's list by a person. Kept, so a later pull does not add it back.
  excludedAt               DateTime?
  /// How it got on the list: market (built from the clinic's counties),
  /// manual (added by a person), or import (a CSV).
  addedFrom                String   @default("manual")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  organizationId           String
  clinicLocation           ClinicLocation @relation(fields: [clinicLocationId], references: [id], onDelete: Cascade)
  practice                 Practice       @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  organization             Organization   @relation(fields: [organizationId], references: [id])

  @@unique([clinicLocationId, practiceId])
  @@index([practiceId])
  @@index([organizationId])
}

/// A subscriber's score for a practice, once for the whole company, which
/// sets its outreach: trusted, warm, cold, or not_fit (never faxed). A
/// practice with no score is treated as cold.
model PracticeScore {
  id             String       @id @default(cuid())
  organizationId String
  practiceId     String
  tier           String
  setAt          DateTime     @default(now())
  setBy          String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  practice       Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, practiceId])
  @@index([practiceId])
}

/// One fax in a campaign. Built from a clinic's referral list: everyone at a
/// practice who resolves to the same machine shares one target, so 24
/// providers at one office is one page, not 24. The number is snapshotted
/// here so what was sent, and to whom, can be shown later.
model CampaignTarget {
  id             String    @id @default(cuid())
  campaignId     String
  practiceId     String?
  practiceName   String
  providerIds    String[]  @default([])
  providerNames  String[]  @default([])
  /// Name on the cover sheet.
  toName         String
  faxNumber      String
  /// "practice" or "provider" (the provider's own line).
  level          String
  status         String    @default("PENDING")
  sentAt         DateTime?
  responseAt     DateTime?
  response       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organizationId String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  practice       Practice?    @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([campaignId])
  @@index([organizationId])
}

/// One row from the NPI dissemination file, kept when its primary taxonomy
/// is a referral-source type. Global, not per organization. Practice ZIP maps
/// to a county at load time. Pulling a county reads this table.
model NpiRecord {
  npi                 String   @id
  entityType          String
  name                String
  firstName           String?
  lastName            String?
  credential          String?
  address1            String?
  address2            String?
  city                String?
  state               String?
  zip                 String?
  postalCode          String?
  phone               String?
  fax                 String?
  /// The mailing address's town and fax. The fax stands in for a practice
  /// that lists none at its location, when mail goes to the same town.
  mailingCity         String?
  mailingState        String?
  mailingFax          String?
  primaryTaxonomyCode String
  taxonomyCodes       String[] @default([])
  countyFips          String?
  /// How the county was found: "hud" (HUD USPS crosswalk), "zcta" (Census land share), or "city" (via city and state).
  countyMatch         String?
  lastUpdated         String?
  loadedAt            DateTime
  /// The NpiLoad that last wrote this row. Rows from an older load are removed when a load completes.
  loadId              String?

  @@index([countyFips])
  @@index([loadId])
  @@index([state, city])
  @@index([zip])
}

/// A run of the NPI file loader.
model NpiLoad {
  id           String    @id @default(cuid())
  fileName     String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("RUNNING")
  rowsRead     Int       @default(0)
  rowsKept     Int       @default(0)
  countyMapped Int       @default(0)
  error        String?
}
